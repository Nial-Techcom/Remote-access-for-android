# NIAL CONTROL - configuration du serveur. Copie installee dans /etc/nial-control/nial.env (droits 640, root:nial).
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
# URL publique HTTPS vue par les applications (obligatoire en production)
PUBLIC_URL=https://nial.example.org
DATA_DIR=/var/lib/nial-control
LOG_LEVEL=info
# 1 uniquement derriere un reverse proxy de confiance sur la meme machine (sinon les IP des clients sont falsifiables)
TRUST_PROXY=1

# Navidrome : compte dedie NON administrateur
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=nial-service
NAVIDROME_PASSWORD_FILE=/etc/nial-control/navidrome.pass

# Flux audio : choisir UNE des deux options
#  A) Passerelle de flux separee pres de Navidrome (flux direct, recommande) : definir STREAM_BASE_URL
#  B) Relais par le serveur central (plus simple, consomme la bande passante du serveur) : RELAY_ENABLED=1
RELAY_ENABLED=1
# STREAM_BASE_URL=https://stream.nial.example.org
# STREAM_SECRETS_FILE=/etc/nial-control/stream.secrets

ALLOWED_ORIGINS=
