# NIAL CONTROL - configuration du serveur (copier en .env, ne jamais committer le vrai fichier)
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
# URL publique (HTTPS) vue par les applications
PUBLIC_URL=https://nial.example.org
# Dossier de donnees (base SQLite, cle de signature, secrets generes)
DATA_DIR=/var/lib/nial-control
LOG_LEVEL=info
# A mettre a 1 uniquement derriere un reverse proxy de confiance
TRUST_PROXY=1

# Navidrome : utiliser un compte dedie NON administrateur
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=nial-service
# Preferer NAVIDROME_PASSWORD_FILE (fichier en lecture seule) a NAVIDROME_PASSWORD
NAVIDROME_PASSWORD_FILE=/etc/nial-control/navidrome.pass

# Liens de flux signes. Le premier secret signe, tous verifient (rotation).
# Genere automatiquement dans DATA_DIR si absent. A fournir pour une passerelle separee.
# STREAM_SECRETS_FILE=/etc/nial-control/stream.secrets
# URL de la passerelle de flux vue par les telephones (defaut : PUBLIC_URL)
# STREAM_BASE_URL=https://stream.nial.example.org
# Relais audio via le serveur central (desactive par defaut)
RELAY_ENABLED=0

# Origines autorisees pour CORS (liste separee par des virgules, vide = aucune)
ALLOWED_ORIGINS=
